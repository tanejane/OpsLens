POSTGRES_DB=opslens
POSTGRES_USER=opslens_admin
POSTGRES_PASSWORD=opslens_local_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://opslens_admin:opslens_local_dev@localhost:5432/opslens

# Comma-separated exact browser origins; scheme, hostname and port must match.
# Overrides legacy OPSLENS_FRONTEND_ORIGIN. No paths, trailing slash or wildcards.
OPSLENS_FRONTEND_ORIGINS=http://localhost:3000
# For HTTPS deployments also set OPSLENS_COOKIE_SECURE=1.
